"""Research agent that writes a PDF report and stores it as an artifact.

Flow: the user asks for research -> the root agent calls the `web_researcher`
sub-agent (Google Search grounding) -> the root agent writes the report in
simple Markdown -> `generate_pdf_report` renders it to PDF bytes and calls
`tool_context.save_artifact(...)`.

The artifact backend is not chosen here. It comes from the Runner / CLI:
    adk web --artifact_service_uri=memory://        # InMemoryArtifactService
    adk web --artifact_service_uri=gs://<bucket>    # GcsArtifactService

google_search is a model built-in tool and cannot share an agent with
function tools, so it lives in its own agent wrapped as an AgentTool.
"""

import re
from datetime import date

from fpdf import FPDF
from google.adk.agents import LlmAgent
from google.adk.tools import ToolContext, google_search
from google.adk.tools.agent_tool import AgentTool
from google.genai import types

MODEL = "gemini-3.5-flash"

# Core PDF fonts are latin-1 only; map the characters LLMs commonly emit.
_CHAR_MAP = {
    "—": "-", "–": "-", "‘": "'", "’": "'",
    "“": '"', "”": '"', "•": "-", "…": "...",
    " ": " ", "→": "->",
}


def _clean(text: str) -> str:
    for src, dst in _CHAR_MAP.items():
        text = text.replace(src, dst)
    return text.encode("latin-1", "replace").decode("latin-1")


def _build_pdf(title: str, report_markdown: str, sources: list[str]) -> bytes:
    """Render simple Markdown (#/##/### headings, - bullets, **bold**) to PDF."""
    pdf = FPDF(format="A4")
    pdf.set_auto_page_break(auto=True, margin=15)
    pdf.set_title(_clean(title))
    pdf.add_page()

    pdf.set_font("Helvetica", "B", 20)
    pdf.multi_cell(0, 10, _clean(title), new_x="LMARGIN", new_y="NEXT")
    pdf.set_font("Helvetica", "I", 10)
    pdf.cell(0, 6, f"Generated {date.today().isoformat()}",
             new_x="LMARGIN", new_y="NEXT")
    pdf.ln(4)

    for raw in report_markdown.splitlines():
        line = _clean(raw.rstrip())
        if not line.strip():
            pdf.ln(3)
            continue
        heading = re.match(r"^(#{1,3})\s+(.*)", line)
        if heading:
            size = {1: 16, 2: 14, 3: 12}[len(heading.group(1))]
            pdf.ln(2)
            pdf.set_font("Helvetica", "B", size)
            pdf.multi_cell(0, 8, heading.group(2).replace("**", ""),
                           new_x="LMARGIN", new_y="NEXT")
            continue
        pdf.set_font("Helvetica", "", 11)
        bullet = re.match(r"^\s*[-*]\s+(.*)", line)
        if bullet:
            pdf.set_x(pdf.l_margin + 5)
            pdf.multi_cell(0, 6, "- " + bullet.group(1), markdown=True,
                           new_x="LMARGIN", new_y="NEXT")
        else:
            pdf.multi_cell(0, 6, line, markdown=True,
                           new_x="LMARGIN", new_y="NEXT")

    if sources:
        pdf.ln(4)
        pdf.set_font("Helvetica", "B", 14)
        pdf.cell(0, 8, "Sources", new_x="LMARGIN", new_y="NEXT")
        pdf.set_font("Helvetica", "", 9)
        for i, src in enumerate(sources, start=1):
            pdf.multi_cell(0, 5, f"[{i}] {_clean(src)}",
                           new_x="LMARGIN", new_y="NEXT")

    return bytes(pdf.output())


async def generate_pdf_report(
    filename: str,
    title: str,
    report_markdown: str,
    sources: list[str],
    tool_context: ToolContext,
) -> dict:
    """Render a research report to PDF and save it as a versioned artifact.

    Args:
        filename: Artifact filename ending in .pdf, e.g. "gcp_finops_report.pdf".
        title: Report title printed at the top of the first page.
        report_markdown: Full report body in simple Markdown. Use "## " for
            section headings, "- " for bullets and **text** for bold.
        sources: Source titles or URLs found during research (may be empty).
        tool_context: Injected by ADK; gives the tool access to artifacts.

    Returns:
        A dict with status, filename, saved version, page count and size.
    """
    if not filename.lower().endswith(".pdf"):
        filename += ".pdf"
    try:
        pdf_bytes = _build_pdf(title, report_markdown, sources)
    except Exception as exc:  # surface render errors to the model, don't crash
        return {"status": "error", "error": f"PDF render failed: {exc}"}

    part = types.Part.from_bytes(data=pdf_bytes, mime_type="application/pdf")
    version = await tool_context.save_artifact(filename, part)
    return {
        "status": "ok",
        "filename": filename,
        "version": version,
        "bytes": len(pdf_bytes),
    }


async def list_reports(tool_context: ToolContext) -> dict:
    """List artifact filenames saved in this session.

    Args:
        tool_context: Injected by ADK; gives the tool access to artifacts.

    Returns:
        A dict with the list of artifact filenames.
    """
    return {"status": "ok", "artifacts": await tool_context.list_artifacts()}


