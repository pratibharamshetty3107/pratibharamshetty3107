#         "findings as bullet points with concrete numbers and dates where "
#         "available, followed by a 'Sources:' list of page titles and URLs."
#     ),
#     tools=[google_search],
# )


root_agent = LlmAgent(
    model=MODEL,
    name="pdf_report_agent",
    description="Researches a topic on the web and produces a PDF report artifact.",
    instruction=(
        "You are a research report writer.\n"
        "1. When the user asks for research on a topic, call google search tool "
        "with a focused request. Call it again for sub-topics if the first "
        "result is thin.\n"
        "2. Write the report in simple Markdown with these sections: "
        "## Executive Summary, ## Key Findings, ## Analysis, ## Conclusion. "
        "Only use facts returned by web_researcher.\n"
        "3. Call generate_pdf_report with a snake_case filename ending in .pdf, "
        "a title, the Markdown body and the source list.\n"
        "4. Reply with a 3-4 line summary and the filename and version saved. "
        "Do not paste the full report into chat.\n"
        "If the user asks which reports exist, call list_reports."
    ),
    #tools=[AgentTool(agent=web_researcher), generate_pdf_report, list_reports],
    tools=[google_search,generate_pdf_report, list_reports],

)
